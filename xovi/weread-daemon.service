[Unit]
Description=weread_daemon (WeRead -> PDF pipeline + review-popup backend)
# No hard dependency on xochitl/xovi any more: the pipeline only writes
# files. Network is what generation actually needs.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/root/weread_daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
